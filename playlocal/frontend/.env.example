# Backend API base URL (including /api/v1). Used for auth, games, etc.
# Default: http://localhost:8080/api/v1
# When using Docker: frontend runs in browser, so keep this to reach backend on host.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY_HERE
