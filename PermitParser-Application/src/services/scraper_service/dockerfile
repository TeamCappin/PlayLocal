# Base environment
FROM mcr.microsoft.com/playwright/python:v1.46.0-jammy

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install dependencies
COPY src/services/scraper_service/requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

# Copy the shared models directory
COPY src/models /app/src/models

# Copy project files
COPY src/services/scraper_service/lib /app/lib
COPY src/services/scraper_service/config /app/config
COPY src/services/scraper_service/scrapers /app/scrapers
COPY src/services/scraper_service/README.md /app/README.md

# Create __init__.py files to make directories proper Python packages
RUN touch /app/src/__init__.py && \
    touch /app/src/models/__init__.py

# Set the PYTHONPATH to include the root so shared models can be found
ENV PYTHONPATH=/app

# Install browsers explicitly
RUN playwright install chromium

# Create non-root user and fix permissions BEFORE switching user
RUN useradd -m scraper && \
    mkdir -p /app/data && \
    chown -R scraper:scraper /app

# Switch to non-root user
USER scraper

# Entry point is the master scraper CLI
ENTRYPOINT ["python3", "-m", "scrapers"]

# Default arguments (can be overridden)
CMD ["--municipality", "laval", "--scraper", "council", "--output", "FILE"]
