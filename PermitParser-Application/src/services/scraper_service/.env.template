# GCS_RAW_BUCKET - Name of the Google Cloud Storage bucket for raw data
GCS_RAW_BUCKET=your-raw-bucket-name
# GCS_OPEN_BUCKET - Name of the Google Cloud Storage bucket for open data
GCS_OPEN_BUCKET=your-open-bucket-name
# GCS_BUCKET - General Google Cloud Storage bucket name (if used)
GCS_BUCKET=your-general-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS - Absolute path to a service-account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json
# LLM_API_KEY - API key for accessing the LLM service
LLM_API_KEY=your-llm-api-key
# LLM_MODEL - Name of the LLM model to use (e.g., "gpt-3.5-turbo")
LLM_MODEL=gpt-3.5-turbo
